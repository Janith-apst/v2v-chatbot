# Phase 1 — local development only.
#
# WARNING: Vite exposes any variable prefixed VITE_ in the client bundle.
# The Gemini API key here will be visible to anyone who loads the deployed app.
# Use a restricted, low-quota key, run only locally, and do NOT deploy publicly.
# A small token-vending backend will replace this in a later phase.

VITE_GEMINI_API_KEY=

# Optional override. Defaults to a current native-audio Live model.
VITE_GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
